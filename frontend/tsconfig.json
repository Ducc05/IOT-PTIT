{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "*.ts"]
}
